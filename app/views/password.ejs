<%- include('partials/header') %>
<section class="card card-narrow">
  <h1>Đổi mật khẩu</h1>
  <% if (errors.length) { %><div class="flash flash-error"><%= errors.join(' ') %></div><% } %>
  <form method="post" action="/account/password" class="form" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Mật khẩu hiện tại <input type="password" name="current_password" required></label>
    <label>Mật khẩu mới (≥ 12 ký tự) <input type="password" name="new_password" minlength="12" required></label>
    <label>Nhập lại mật khẩu mới <input type="password" name="confirm_password" minlength="12" required></label>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
  </form>
  <p class="muted">Sau khi đổi mật khẩu, phiên đăng nhập hiện tại sẽ bị hủy.</p>
</section>
<%- include('partials/footer') %>
